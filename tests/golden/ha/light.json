{
  "name": null,
  "unique_id": "nanoleaf2mqtt_living-room_light",
  "default_entity_id": "light.nanoleaf_living_room",
  "device": {
    "identifiers": ["nanoleaf2mqtt_living-room"],
    "name": "Test Shapes",
    "manufacturer": "Nanoleaf",
    "model": "NL42",
    "sw_version": "12.0.3"
  },
  "origin": {
    "name": "nanoleaf2mqtt",
    "sw_version": "<version>"
  },
  "availability": [
    {
      "topic": "nanoleaf/connected",
      "value_template": "{{ 'online' if value == '2' else 'offline' }}"
    },
    {
      "topic": "nanoleaf/status/living-room/reachable",
      "value_template": "{{ 'online' if value_json is defined and value_json.val == true else 'offline' }}"
    }
  ],
  "availability_mode": "all",
  "qos": 1,
  "state_topic": "nanoleaf/status/living-room/on",
  "state_value_template": "{{ 'true' if value_json.val else 'false' }}",
  "command_topic": "nanoleaf/set/living-room/on",
  "payload_on": "true",
  "payload_off": "false",
  "brightness_state_topic": "nanoleaf/status/living-room/brightness",
  "brightness_value_template": "{{ value_json.val }}",
  "brightness_command_topic": "nanoleaf/set/living-room/brightness",
  "brightness_scale": 100,
  "hs_state_topic": "nanoleaf/status/living-room/hs",
  "hs_value_template": "{{ value_json.val | join(',') }}",
  "hs_command_topic": "nanoleaf/set/living-room/hs",
  "hs_command_template": "{{ hue | round | int }},{{ sat | round | int }}",
  "color_temp_kelvin": true,
  "color_temp_state_topic": "nanoleaf/status/living-room/ct",
  "color_temp_value_template": "{{ value_json.val }}",
  "color_temp_command_topic": "nanoleaf/set/living-room/ct",
  "min_kelvin": 1200,
  "max_kelvin": 6500,
  "effect_state_topic": "nanoleaf/status/living-room/effect",
  "effect_value_template": "{{ value_json.val }}",
  "effect_command_topic": "nanoleaf/set/living-room/effect",
  "effect_list": ["Blaze", "Northern Lights", "Prism"]
}
